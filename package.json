{
  "name": "nest-js-starter",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Reusable production backend starter",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err src && tsx scripts/architecture/check-module-imports.ts src",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "manifest:check": "tsx scripts/manifest/check-starter-manifest.ts",
    "test:architecture": "jest --config jest.architecture.config.mjs --runInBand",
    "test:unit": "jest --config jest.unit.config.mjs --runInBand",
    "typecheck": "corepack pnpm@11.15.1 run typecheck:src && corepack pnpm@11.15.1 run typecheck:test",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@microsoft/tsdoc": "0.16.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "15.15.0",
    "jest": "30.4.2",
    "prettier": "3.9.5",
    "ts-jest": "29.4.11",
    "tsc-alias": "1.8.16",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
