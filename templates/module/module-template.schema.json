{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nest-js-starter.invalid/schemas/module-template.schema.json",
  "title": "NestJS Starter Module Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "target"],
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
