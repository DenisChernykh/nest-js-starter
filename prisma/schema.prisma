generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  RETIRED
}

enum PasswordResetTokenSource {
  SELF_SERVICE
  ADMINISTRATOR
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxMessageStatus {
  PENDING
  CLAIMED
  PUBLISHED
  BLOCKED
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  email                   String
  normalizedEmail         String                  @unique @map("normalized_email")
  status                  UserStatus              @default(ACTIVE)
  accountRevision         Int                     @default(0) @map("account_revision")
  sessionGeneration       BigInt                  @default(0) @map("session_generation")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  emailVerifiedAt         DateTime?               @map("email_verified_at")
  retiredAt               DateTime?               @map("retired_at")
  credential              PasswordCredential?
  roles                   UserRole[]
  emailVerificationToken  EmailVerificationToken?
  passwordResetToken      PasswordResetToken?
  invitationToken         AccountInvitationToken?
  createdApprovalRequests ApprovalRequest[]       @relation("ApprovalRequestCreator")
  decidedApprovalRequests ApprovalRequest[]       @relation("ApprovalRequestDecider")

  @@map("users")
}

model ApprovalRequest {
  id              String                @id @default(uuid()) @db.Uuid
  title           String                @db.VarChar(120)
  description     String                @db.VarChar(2000)
  status          ApprovalRequestStatus @default(PENDING)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  decidedByUserId String?               @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  decidedAt       DateTime?             @map("decided_at")
  createdBy       User                  @relation("ApprovalRequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedBy       User?                 @relation("ApprovalRequestDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId])
  @@map("approval_requests")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model EmailVerificationToken {
  userId      String   @id @map("user_id") @db.Uuid
  tokenDigest String   @unique @map("token_digest") @db.VarChar(43)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  userId      String                   @id @map("user_id") @db.Uuid
  tokenDigest String                   @unique @map("token_digest") @db.VarChar(43)
  expiresAt   DateTime                 @map("expires_at")
  createdAt   DateTime                 @map("created_at")
  source      PasswordResetTokenSource @default(SELF_SERVICE)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AccountInvitationToken {
  userId      String   @id @map("user_id") @db.Uuid
  tokenDigest String   @unique @map("token_digest") @db.VarChar(43)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_invitation_tokens")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleKey   String   @map("role_key")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleKey])
  @@map("user_roles")
}

model AuthSecurityState {
  id                        Int       @id
  globalSessionEpoch        BigInt    @default(0) @map("global_session_epoch")
  adminBootstrapCompletedAt DateTime? @map("admin_bootstrap_completed_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@map("auth_security_state")
}

model OutboxMessage {
  id            String              @id @db.Uuid
  destination   String              @db.VarChar(100)
  type          String              @db.VarChar(120)
  version       Int
  partitionKey  String?             @map("partition_key") @db.VarChar(200)
  correlationId String?             @map("correlation_id") @db.VarChar(200)
  occurredAt    DateTime            @map("occurred_at")
  payload       Json
  payloadSizeBytes Int              @map("payload_size_bytes")
  status        OutboxMessageStatus @default(PENDING)
  attemptCount  Int                 @default(0) @map("attempt_count")
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at")
  claimToken    String?             @map("claim_token") @db.Uuid
  claimedBy     String?             @map("claimed_by") @db.VarChar(160)
  claimedUntil  DateTime?           @map("claimed_until")
  publishedAt   DateTime?           @map("published_at")
  blockedAt     DateTime?           @map("blocked_at")
  lastErrorCode String?             @map("last_error_code") @db.VarChar(100)
  redrivePublished Boolean          @default(false) @map("redrive_published")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([destination, status, nextAttemptAt, claimedUntil])
  @@index([status, publishedAt])
  @@map("outbox_messages")
}
