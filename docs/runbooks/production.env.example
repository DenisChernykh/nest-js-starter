# Copy this file to the server-side .env, chmod 600, and enter real values only
# on the server. This template contains names and symbolic placeholders.
APP_IMAGE=<immutable-ghcr-image@sha256-digest>
API_DOCS_MODE=<off-or-protected>
AUTH_CSRF_SECRET=<secret-manager-value>
AUTH_NETWORK_METADATA_SECRET=<secret-manager-value>
AUTH_RATE_LIMIT_KEY_SECRET=<secret-manager-value>
AUTH_SESSION_KEY_SECRET=<secret-manager-value>
CADDY_NETWORK=<existing-external-caddy-network>
CADDY_UPSTREAM_ALIAS=<unique-api-upstream-alias>
CORS_ORIGINS=<comma-separated-https-browser-origins>
DATABASE_POOL_MAX=<positive-integer>
GHCR_READ_TOKEN=<secret-manager-value>
GHCR_USERNAME=<read-only-ghcr-identity>
LOG_LEVEL=<trace-debug-info-warn-error-fatal>
NODE_ENV=production
OBSERVABILITY_NETWORK=<existing-external-observability-network>
OTEL_EXPORTER_OTLP_ENDPOINT=<shared-alloy-otlp-http-endpoint>
OTEL_SERVICE_NAME=<service-name>
OTEL_SDK_DISABLED=<true-or-false>
POSTGRES_ADMIN_PASSWORD=<secret-manager-value>
POSTGRES_ADMIN_USER=<postgres-admin-role>
POSTGRES_DB=<database-name>
POSTGRES_MIGRATOR_PASSWORD=<secret-manager-value>
POSTGRES_MIGRATOR_USER=app_migrator
POSTGRES_RUNTIME_PASSWORD=<secret-manager-value>
POSTGRES_RUNTIME_USER=app_runtime
PUBLIC_API_URL=<https-public-api-origin>
REDIS_KEY_PREFIX=<stable-service-key-prefix>
REDIS_PASSWORD=<secret-manager-value>
SERVICE_REVISION=<exact-40-lowercase-hex-source-revision>
SERVICE_VERSION=<service-version>
TRUST_PROXY_CIDRS=<environment-owned-proxy-cidrs>
