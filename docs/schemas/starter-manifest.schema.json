{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nest-js-starter.invalid/schemas/starter-manifest.schema.json",
  "title": "NestJS Starter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "starter", "appliedRecipes"],
  "properties": {
    "$schema": {
      "const": "./docs/schemas/starter-manifest.schema.json"
    },
    "manifestVersion": {
      "const": 1
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceRevision"],
      "properties": {
        "name": {
          "const": "nest-js-starter"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(?:unreleased|[0-9a-f]{40})$"
        }
      }
    },
    "appliedRecipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appliedRecipe"
      }
    }
  },
  "$defs": {
    "appliedRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceRevision"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(?:unreleased|[0-9a-f]{40})$"
        }
      }
    }
  }
}
