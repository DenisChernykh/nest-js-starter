NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=
HTTP_JSON_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_DRAIN_TIMEOUT_MS=6000
SHUTDOWN_GRACE_MS=10000
DATABASE_URL=postgresql://nest_js_starter:nest_js_starter@localhost:5432/nest_js_starter?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_HEALTH_TIMEOUT_MS=2000
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000
REDIS_COORDINATION_URL=redis://default:local-development-only@127.0.0.1:6379
# Optional until a module explicitly registers a cache adapter. Use a separate
# evictable Redis service in production; do not use logical DB numbers.
REDIS_CACHE_URL=
POSTGRES_DB=nest_js_starter
POSTGRES_USER=nest_js_starter
POSTGRES_PASSWORD=nest_js_starter
POSTGRES_PORT=5432
REDIS_PORT=6379
