NODE_ENV=development
LOG_LEVEL=info
OTEL_SERVICE_NAME=nest-js-starter
SERVICE_VERSION=0.1.0-alpha.0
SERVICE_REVISION=local
OTEL_SDK_DISABLED=false
# Generic OTLP HTTP base appends /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTLP_HTTP_PORT=4318
API_HOST=127.0.0.1
API_PORT=3000
GRAFANA_PORT=3004
# Defaults to public in development/test and off in production. Every stage
# deployment must override this with protected explicitly; production accepts
# only off/protected and rejects public during configuration validation.
API_DOCS_MODE=public
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=
DATABASE_URL=postgresql://nest_js_starter:nest_js_starter@localhost:5432/nest_js_starter?schema=public
DATABASE_POOL_MAX=10
REDIS_AUTH_URL=redis://default:local-development-only@127.0.0.1:6379
REDIS_KEY_PREFIX=nest-js-starter
# Development-only sample keys. Generate four independent 32-byte base64url
# values for every deployed environment; never reuse these sample values.
AUTH_SESSION_KEY_SECRET=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
AUTH_CSRF_SECRET=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
AUTH_RATE_LIMIT_KEY_SECRET=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM
AUTH_NETWORK_METADATA_SECRET=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ
# Self-service is opt-in. Open mode requires an app origin, SMTP URL and from address.
AUTH_SELF_SERVICE_MODE=disabled
# Copy-paste this block for an API running in Compose with the Mailpit profile:
# AUTH_SELF_SERVICE_MODE=open
# AUTH_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SMTP_URL=smtp://mail:1025
# AUTH_MAIL_FROM=no-reply@example.com
# For an API running on the host instead, use AUTH_SMTP_URL=smtp://127.0.0.1:1025.
POSTGRES_DB=nest_js_starter
POSTGRES_USER=nest_js_starter
POSTGRES_PASSWORD=nest_js_starter
POSTGRES_PORT=5432
REDIS_AUTH_PORT=6379
# Mailpit is opt-in through `docker compose --profile mail up`.
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
# Optional BullMQ capability. Start Compose with --profile queues first.
REDIS_QUEUE_PORT=6380
# REDIS_QUEUE_URL=redis://default:local-development-queue-only@127.0.0.1:6380
