NODE_ENV=development
LOG_LEVEL=info
OTEL_SERVICE_NAME=nest-js-starter
SERVICE_VERSION=0.1.0-alpha.0
SERVICE_REVISION=local
OTEL_SDK_DISABLED=false
# Generic OTLP HTTP base appends /v1/traces and /v1/metrics. Signal-specific
# endpoints, when set, are used exactly as provided.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=1000
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=10000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=1000
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=
HTTP_JSON_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_DRAIN_TIMEOUT_MS=6000
SHUTDOWN_GRACE_MS=10000
DATABASE_URL=postgresql://nest_js_starter:nest_js_starter@localhost:5432/nest_js_starter?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_HEALTH_TIMEOUT_MS=2000
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000
REDIS_COORDINATION_URL=redis://default:local-development-only@127.0.0.1:6379
# Optional until a module explicitly registers a cache adapter. Use a separate
# evictable Redis service in production; do not use logical DB numbers.
REDIS_CACHE_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_HEALTH_TIMEOUT_MS=2500
REDIS_SHUTDOWN_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=nest-js-starter
AUTH_SESSION_COOKIE_NAME=nest-js-starter-session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TIMEOUT_MS=604800000
AUTH_SESSION_ABSOLUTE_TIMEOUT_MS=2592000000
AUTH_SESSION_TOUCH_INTERVAL_MS=300000
# Development-only sample keys. Generate four independent 32-byte base64url
# values for every deployed environment; never reuse these sample values.
AUTH_SESSION_KEY_SECRET=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
AUTH_CSRF_SECRET=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
AUTH_RATE_LIMIT_KEY_SECRET=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM
AUTH_NETWORK_METADATA_SECRET=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ
AUTH_CSRF_ORIGINS=http://localhost:3000
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_WINDOW_MS=900000
POSTGRES_DB=nest_js_starter
POSTGRES_USER=nest_js_starter
POSTGRES_PASSWORD=nest_js_starter
POSTGRES_PORT=5432
REDIS_PORT=6379
